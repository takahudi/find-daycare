{
  "name": "find-daycare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "lint": "pnpm types:worker && oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm types:worker && tsc -b",
    "types:worker": "wrangler types --config wrangler.jsonc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preview": "vite preview",
    "prepare": "node scripts/install-git-hooks.ts",
    "data:fetch": "node scripts/fetch-sources.ts",
    "data:build": "pnpm data:verify && node scripts/extract-pdf-details.ts && node scripts/extract-kigyo-details.ts && node scripts/build-data.ts",
    "data:update": "pnpm data:fetch && pnpm data:build",
    "data:manifest": "node scripts/data-manifest.ts",
    "data:archive": "node scripts/data-archive.ts",
    "data:restore": "node scripts/data-restore.ts",
    "data:verify": "node scripts/data-verify.ts",
    "map:extract": "node scripts/map-tiles/extract.ts",
    "map:archive": "node scripts/map-tiles/archive.ts",
    "map:local": "node scripts/map-tiles/local.ts",
    "map:fixture": "node scripts/map-tiles/seed-e2e.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "nuqs": "^2.10.2",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.0.9",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws4fetch": "^1.0.20",
    "babel-plugin-react-compiler": "^1.0.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pdfjs-dist": "^6.4.299",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3",
    "xlsx": "^0.18.5"
  }
}
