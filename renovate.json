{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor", "helpers:pinGitHubActionDigestsToSemver"],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "3 days"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 * * 1"]
  },
  "packageRules": [
    {
      "description": "Node.js のメジャー更新（.node-version）と同じ PR で手動で上げる",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["* 0-3 * * 1"]
    }
  ]
}
